# required
ARTMEM_TOKEN=change-me-to-a-long-random-string

# web search for spoken questions (lookup agent falls back to it after memory search)
# Point at a SearxNG you already run — from a container, the host IP:port or
# http://host.docker.internal:PORT works. Set backend=none to disable web search.
ARTMEM_SEARCH__BACKEND=searxng
SEARCH_URL=http://searxng:8080
#   ↑ default matches the BUNDLED SearxNG (`--profile bundled-search`). If you reuse
#     an existing one, set SEARCH_URL to it (e.g. http://192.168.1.10:8810).
# Only needed if you RUN the bundled SearxNG profile:
SEARXNG_SECRET=change-me-too
SEARXNG_PORT=8888

# optional overrides (names mirror config.yaml via ARTMEM_SECTION__KEY)
ARTMEM_PORT=8378

# any OpenAI-compatible LLM endpoint; leave empty for fully-local (llama.cpp etc.)
ARTMEM_LLM__BASE_URL=https://openrouter.ai/api/v1
ARTMEM_LLM__MODEL_FAST=openai/gpt-4o-mini
ARTMEM_LLM__MODEL_DEEP=openai/gpt-4o
LLM_API_KEY=
# per-call ceiling; local reasoning models (e.g. qwen3-next @ ~7 tok/s) need minutes
ARTMEM_LLM__TIMEOUT_S=120

# embeddings: defaults to the LLM endpoint above if unset
ARTMEM_LLM__EMBEDDING_BASE_URL=
ARTMEM_LLM__EMBEDDING_MODEL=
EMBEDDING_API_KEY=
