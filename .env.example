# required
AMBIENT_TOKEN=change-me-to-a-long-random-string
SEARXNG_SECRET=change-me-too

# optional overrides (names mirror config.yaml via AMBIENT_SECTION__KEY)
AMBIENT_PORT=8378
SEARXNG_PORT=8888

# any OpenAI-compatible LLM endpoint; leave empty for fully-local (llama.cpp etc.)
AMBIENT_LLM__BASE_URL=https://openrouter.ai/api/v1
AMBIENT_LLM__MODEL_FAST=openai/gpt-4o-mini
AMBIENT_LLM__MODEL_DEEP=openai/gpt-4o
LLM_API_KEY=

# embeddings: defaults to the LLM endpoint above if unset
AMBIENT_LLM__EMBEDDING_BASE_URL=
AMBIENT_LLM__EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# set to `none` to disable web-search fallback for spoken questions
AMBIENT_SEARCH__BACKEND=searxng
