# Root env for docker compose. Copy to .env.
# Generate a token: openssl rand -hex 32
AMBIENT_TOKEN=change-me-to-a-256-bit-hex-token
LLM_API_KEY=
EMBEDDING_API_KEY=
# Point at your OpenAI-compatible endpoint (vLLM / llama.cpp / Ollama / OpenRouter)
AMBIENT_LLM__BASE_URL=http://host.docker.internal:8000/v1
AMBIENT_LLM__MODEL_FAST=gpt-4o-mini
AMBIENT_LLM__MODEL_DEEP=gpt-4o
TZ=America/Los_Angeles
